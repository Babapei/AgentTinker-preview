    "Capabilities": {
      "additionalProperties": false,
      "properties": {
        "fork_from_checkpoint": {
          "default": false,
          "title": "Fork From Checkpoint",
          "type": "boolean"
        },
        "parallel_fork": {
          "const": false,
          "default": false,
          "title": "Parallel Fork",
          "type": "boolean"
        },
        "patch_arbitrary_state": {
          "const": false,
          "default": false,
          "title": "Patch Arbitrary State",
          "type": "boolean"
        },
        "patch_tool_policy": {
          "default": false,
          "title": "Patch Tool Policy",
          "type": "boolean"
        },
        "pause_live_execution": {
          "const": false,
          "default": false,
          "title": "Pause Live Execution",
          "type": "boolean"
        },
        "record_playback": {
          "default": true,
          "title": "Record Playback",
          "type": "boolean"
        },
        "run_from_start": {
          "default": false,
          "title": "Run From Start",
          "type": "boolean"
        },
        "trace_view": {
          "default": true,
          "title": "Trace View",
          "type": "boolean"
        }
      },
      "required": [
        "trace_view",
        "record_playback",
        "run_from_start",
        "fork_from_checkpoint",
        "patch_tool_policy",
        "patch_arbitrary_state",
        "pause_live_execution",
        "parallel_fork"
      ],
      "title": "Capabilities",
      "type": "object"
    },
    "CheckpointRef": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Adapter",
          "type": "string"
        },
        "agent_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Agent Version",
          "type": "string"
        },
        "allowed_patch_fields": {
          "default": [],
          "items": {
            "enum": [
              "tool_retry_limit",
              "top_k"
            ],
            "type": "string"
          },
          "title": "Allowed Patch Fields",
          "type": "array"
        },
        "boundary": {
          "const": "before_tool",
          "default": "before_tool",
          "title": "Boundary",
          "type": "string"
        },
        "checkpoint_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Checkpoint Id",
          "type": "string"
        },
        "locator": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Locator",
          "type": "object"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "runtime_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Runtime Version",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_versions": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.:-]*$": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            }
          },
          "title": "Tool Versions",
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "checkpoint_id",
        "run_id",
        "adapter",
        "runtime_version",
        "agent_version",
        "tool_versions",
        "boundary",
        "locator",
        "allowed_patch_fields"
      ],
