          ],
          "default": null,
          "title": "Source Checkpoint Id"
        },
        "status": {
          "$ref": "#/$defs/RunStatus",
          "default": "queued"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
